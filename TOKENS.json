      },
      "bg-light": {
        "value": "rgba(99, 102, 241, 0.03)",
        "type": "color"
      },
      "bg-dark": {
        "value": "rgba(99, 102, 241, 0.08)",
        "type": "color"
      }
    },
    "badges": {
