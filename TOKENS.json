        "bg-light": { "value": "#e0e7ff", "type": "color" },
        "text-light": { "value": "#4338ca", "type": "color" },
        "bg-dark": { "value": "rgba(99, 102, 241, 0.2)", "type": "color" },
        "text-dark": { "value": "#a5b4fc", "type": "color" }
