        "text-dark": { "value": "#86efac", "type": "color" }
      },
      "execution-mode": {
        "bg-light": { "value": "#f1f5f9", "type": "color" },
        "text-light": { "value": "#334155", "type": "color" },
        "bg-dark": { "value": "rgba(148, 163, 184, 0.15)", "type": "color" },
        "text-dark": { "value": "#cbd5e1", "type": "color" }
      }
    }
