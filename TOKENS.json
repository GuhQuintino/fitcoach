  "typography": {
    "fontFamily": {
      "display": { "value": "'Outfit', system-ui, sans-serif", "type": "fontFamily" },
      "body": { "value": "'DM Sans', system-ui, sans-serif", "type": "fontFamily" }
    },
    "fontSize": {
      "badge": { "value": "11px", "type": "dimension" },
      "badge-sm": { "value": "10px", "type": "dimension" },
      "sub-set": { "value": "12px", "type": "dimension" },
      "body": { "value": "14px", "type": "dimension" },
      "header": { "value": "16px", "type": "dimension" },
      "title": { "value": "18px", "type": "dimension" }
    },
    "fontWeight": {
      "bold": { "value": "700", "type": "fontWeight" },
      "extrabold": { "value": "800", "type": "fontWeight" },
      "black": { "value": "900", "type": "fontWeight" }
    }
  },
  "spacing": {
    "touch-target": { "value": "44px", "type": "dimension", "description": "Tamanho mínimo para acessibilidade de botões e badges" },
    "group-padding": { "value": "16px", "type": "dimension" },
    "sub-set-indent": { "value": "20px", "type": "dimension", "description": "Recuo para sub-linhas de dropset e clusters" }
  },
  "border": {
    "radius": {
      "badge": { "value": "9999px", "type": "dimension" },
      "card": { "value": "20px", "type": "dimension" },
      "modal": { "value": "24px", "type": "dimension" },
      "input": { "value": "12px", "type": "dimension" }
    }
  },
  "motion": {
    "transition": {
      "default": { "value": "all 200ms cubic-bezier(0.16, 1, 0.3, 1)", "type": "transition" },
      "scale-tap": { "value": "transform 150ms ease-out", "type": "transition" }
    },
    "timer-pulse": {
      "animation": { "value": "pulse-soft 2s ease-in-out infinite", "type": "animation" }
    }
  }
}
